# Relative on purpose -- the browser calls this frontend's own origin, and
# next.config.ts's rewrite forwards it server-side to BACKEND_INTERNAL_URL.
# This keeps the session cookie first-party (see next.config.ts for why).
NEXT_PUBLIC_API_URL=/api/v1
# Server-only (no NEXT_PUBLIC_ prefix -- never sent to the browser): where the
# rewrite above actually forwards requests. Point this at the real backend
# URL in each environment (e.g. the Railway backend's *.up.railway.app URL
# in production).
BACKEND_INTERNAL_URL=http://localhost:5000
# Optional: frontend error monitoring. Leave empty to disable entirely (no
# Sentry code runs, no network calls, nothing bundled beyond the static
# import boundary) -- see app/lib/sentry.ts.
NEXT_PUBLIC_SENTRY_DSN=
