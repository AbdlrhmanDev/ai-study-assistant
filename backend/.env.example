NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_assistant
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Requests per 15 minutes
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10

# AI requests per authenticated user per hour
AI_RATE_LIMIT=30

# Choose: gemini, groq, or openai
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
