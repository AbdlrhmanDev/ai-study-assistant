NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_assistant
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# Requests per 15 minutes
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
# Requests per hour, per logged-in user (or per IP if anonymous)
AI_RATE_LIMIT=30

# Topic-scoped hybrid (vector + BM25) retrieval settings
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_VECTOR_TOP_K=10
RAG_BM25_TOP_K=10
RAG_RRF_K=60

# Embeddings are independent from AI_PROVIDER (Groq has no embeddings API).
# Choose: gemini or openai. Both are standardized on 768 dimensions so
# switching providers never requires a schema migration.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Document uploads (requires the pgvector Postgres extension -- see README)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Only "local" is implemented today; an object-storage backend is a
# documented future addition (see app/modules/ai/storage.py).
STORAGE_BACKEND=local

# Choose: gemini, groq, or openai
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
