NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_assistant
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# Requests per 15 minutes
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
# Requests per hour, per logged-in user (or per IP if anonymous)
AI_RATE_LIMIT=30
# Optional: share rate-limit counters across replicas via Redis instead of
# per-instance memory (e.g. redis://localhost:6379/0). Leave empty to keep
# counting in-process -- fine for a single instance, but each replica then
# enforces the limits independently. Falls back to in-memory automatically
# if Redis is unreachable.
REDIS_URL=

# Topic-scoped hybrid (vector + BM25) retrieval settings
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_VECTOR_TOP_K=10
RAG_BM25_TOP_K=10
RAG_RRF_K=60

# Embeddings are independent from AI_PROVIDER (Groq has no embeddings API).
# Choose: gemini or openai. Both are standardized on 768 dimensions so
# switching providers never requires a schema migration.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Document uploads (requires the pgvector Postgres extension -- see README)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Flat beta-wide cap on total storage per user, across all documents (no
# billing/plan tiers yet -- see max_storage_mb_per_user in core/config.py)
MAX_STORAGE_MB_PER_USER=500
# Use local only for development. Production must use an S3-compatible
# provider (AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900
ABANDONED_UPLOAD_MINUTES=60
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Phase 1 operations
JOB_QUEUE_NAME=studia:jobs
JOB_MAX_RETRIES=4
SENTRY_DSN=
# Log (and count via a metric) any SQL query that takes longer than this to
# run. Query text is truncated/parameterized in the log line -- never raw
# user content.
SLOW_QUERY_MS=500
AI_MONTHLY_REQUEST_LIMIT=500
# Optional JSON override of per-feature daily/monthly caps -- e.g.
# {"quiz":{"daily":5},"chat":{"monthly":200}}. Omitted features/keys keep
# the built-in defaults (see DEFAULT_AI_FEATURE_LIMITS in app/core/config.py).
AI_FEATURE_LIMITS=
# Route individual AI features to lower-cost providers. Example:
# {"chat":"openai","quiz":"groq","flashcards":"groq","knowledge_graph":"gemini"}
AI_FEATURE_PROVIDERS=
AI_ARTIFACT_CACHE_TTL_SECONDS=86400
# Default plan tier for accounts whose `plan` column is empty (e.g. created
# before the plans migration). Must be a key of the plan tiers below.
DEFAULT_PLAN=beta
# Optional JSON override of the plan tiers -- e.g.
# {"beta":{"label":"Beta","storage_mb":500,"monthly_request_limit":500,"feature_multiplier":1,"monthly_price_usd":0}}
# Omitted tiers/keys keep the built-in defaults (see DEFAULT_PLAN_TIERS in
# app/core/config.py).
PLAN_TIERS=
# Fraction of a limit (global or per-feature) at which the frontend should
# show a warning before the hard cutoff.
SOFT_LIMIT_WARNING_THRESHOLD=0.8
ADMIN_EMAILS=

# Optional review reminder email delivery. Keep unset to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
APP_PUBLIC_URL=http://localhost:3000

# Choose: gemini, groq, or openai
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
